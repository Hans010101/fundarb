  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
