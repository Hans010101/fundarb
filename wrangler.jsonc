{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundarb-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "EXECUTION_RELAY_URL": "",
    "AUTHORIZED_EMAIL": "hans.pan007@gmail.com",
    "POLICY_AUD": "d05a2be4ac42ec1e71b9dff98a71ed024eb9f56f670f8b2dc52b8f4324b2956c",
    "TEAM_DOMAIN": "https://hans-pan007.cloudflareaccess.com"
  },
  "secrets": {
    "required": ["ADMIN_API_TOKEN", "CREDENTIAL_MASTER_KEY", "EXECUTION_RELAY_TOKEN"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundarb-core",
      "database_id": "3aa523f0-eeaf-4bf9-8daf-a13dfcfa9f5b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
